  "options": {
    "step": {
      "init": {
        "title": "Master data",
        "description": "Facts about the system that cannot be measured. Empty fields are allowed: the affected check then shows “not assessable – master data missing”.",
        "sections": {
          "plant": {
            "name": "System",
            "data": {
              "hydraulic_separation": "Hydraulic separation",
              "flow_rate_min_lpm": "Minimum flow rate",
              "circuit_flow_max_lpm": "Max. heating circuit pump flow",
              "capacity_min_table": "Minimum capacity from data sheet",
              "immersion_heater_kw": "Immersion heater power",
              "booster_heater_kw": "Booster heater 1 power",
              "booster_heater_2_kw": "Booster heater 2 power",
              "dhw_tank_volume_l": "Hot water tank volume"
            },
            "data_description": {
              "hydraulic_separation": "How heat pump and heating circuit are connected. Decides whether the buffer loss (T1) is checked.",
              "flow_rate_min_lpm": "Smallest permitted heat pump flow rate according to the manufacturer (T4).",
              "circuit_flow_max_lpm": "Largest flow of the heating circuit pump according to the data sheet (highest curve at zero head); an upper bound regardless of the setting. The estimate in T3 never shows more (1 m³/h = 16.7 l/min).",
              "capacity_min_table": "Smallest heating capacity in kW per flow temperature and outdoor temperature (C4). Format (YAML): one line per flow temperature, below it indented outdoor: kW, e.g. \"35:\" followed by \"-7: 3.9\", \"2: 3.5\", \"7: 3.5\". Values in between are interpolated linearly.",
              "immersion_heater_kw": "Electric immersion heater in the cylinder (C5).",
              "booster_heater_kw": "Electric booster heater in the heating circuit (C5).",
              "booster_heater_2_kw": "Second booster stage, if present (C5).",
              "dhw_tank_volume_l": "Nominal volume from the rating plate (W4)."
            },
            "description": "Manufacturer data from the data sheet or installation manual."
          },
          "site": {
            "name": "Site and comfort",
            "data": {
              "heating_hours": "Heating hours per year",
              "room_temp_target": "Target room temperature",
              "heating_degree_days": "Heating degree days per year"
            },
            "data_description": {
              "heating_hours": "Hours with outdoor temperature below the heating limit (15 °C) at the site. Used to project starts per year (C1).",
              "room_temp_target": "Desired temperature in the reference room (T6).",
              "heating_degree_days": "Long-term average of heating degree days (base 20/15 °C) at the site. For the annual projection (K2)."
            }
          },
          "cost": {
            "name": "Cost",
            "description": "Gross prices. The energy price is suggested from the energy dashboard if the heat pump meter is set up there.",
            "data": {
              "tariff_price": "Heat pump energy price",
              "tariff_base_fee": "Heat pump meter standing charge",
              "household_price": "Household energy price",
              "reference_fuel_price": "Previous fuel price",
              "reference_efficiency": "Previous heating efficiency"
            },
            "data_description": {
              "tariff_price": "Price per kWh of heat pump electricity (K1, K2).",
              "tariff_base_fee": "Only the additional standing charge per year for a separate heat pump meter; leave empty without one.",
              "household_price": "For comparison: is the separate heat pump tariff worth it (K3)?",
              "reference_fuel_price": "For comparison, e.g. gas: cost per kWh including the share of the standing charge (K1, K2).",
              "reference_efficiency": "Share of the billed fuel that arrives as heat. Gas condensing boilers reach 0.86 on average in field tests, based on the gross calorific value that gas is billed by."
            }
          },
          "evaluation": {
            "name": "Evaluation",
            "data": {
              "window_days": "Evaluation window",
              "data_since": "Use data from",
              "data_source": "Data source"
            },
            "data_description": {
              "window_days": "How many days back are evaluated.",
              "data_since": "Older data is ignored, e.g. before the interface was installed."
            },
            "description": "The recorder only keeps its retention period (default 10 days); InfluxDB goes further back."
          }
        }
      }
    },
